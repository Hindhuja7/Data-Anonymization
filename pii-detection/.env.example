# SOURCE DATABASE Configuration (Read-Only)
SOURCE_DB_TYPE=postgresql
SOURCE_DB_HOST=ep-royal-cake-admnq88c.c-2.us-east-1.aws.neon.tech
SOURCE_DB_PORT=5432
SOURCE_DB_USERNAME=your_username
SOURCE_DB_PASSWORD=your_password
SOURCE_DB_NAME=neondb
SOURCE_DB_SSLMODE=require

# DESTINATION DATABASE Configuration (Write Access)
# This MUST be a completely separate database from SOURCE_DB_NAME
DEST_DB_TYPE=postgresql
DEST_DB_HOST=ep-royal-cake-admnq88c.c-2.us-east-1.aws.neon.tech
DEST_DB_PORT=5432
DEST_DB_USERNAME=your_username
DEST_DB_PASSWORD=your_password
DEST_DB_NAME=neondb_anonymized
DEST_DB_SSLMODE=require

# LLM Configuration
LLM_PROVIDER=github
LLM_MODEL=gpt-4o

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# HMAC Secret for secure Redis key generation
# Generate a strong random secret and keep it secure
HMAC_SECRET=your-secure-hmac-secret-key-change-in-production

# Encryption Key for Redis data encryption (Fernet)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: Keep this key consistent across pipeline runs to decrypt existing Redis data
ENCRYPTION_KEY=your-fernet-encryption-key-change-in-production

# Policy Configuration
POLICY_FILE=anonymization_policy.json

# Chunk Size for processing (rows per chunk)
# Use smaller values (10-100) for testing, larger (1000-10000) for production
CHUNK_SIZE=10
